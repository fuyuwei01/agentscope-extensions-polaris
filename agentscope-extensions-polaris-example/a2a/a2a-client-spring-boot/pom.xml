<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tencent.ai.polaris</groupId>
        <artifactId>agentscope-extensions-polaris-example-a2a</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentscope-extensions-polaris-example-a2a-client-spring-boot</artifactId>
    <name>AgentScope Extensions Polaris Example A2A Client (Spring Boot)</name>
    <description>Discovers an A2A agent from Polaris and invokes it, wired by Spring Boot</description>

    <properties>
        <spring.boot.version>4.0.3</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.tencent.ai.polaris</groupId>
            <artifactId>agentscope-extensions-polaris-example-a2a-client</artifactId>
            <version>${revision}</version>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Polaris Spring Boot starter: provides PolarisAgentCardResolver bean + PolarisContextManager -->
        <dependency>
            <groupId>com.tencent.ai.polaris</groupId>
            <artifactId>agentscope-extensions-polaris-spring-boot-starter</artifactId>
        </dependency>

        <!-- AgentScope A2A client (A2aAgent + AgentCardResolver SPI) -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-a2a-client</artifactId>
        </dependency>

        <!-- AgentScope core (Msg / MsgRole / TextBlock / stream) -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
