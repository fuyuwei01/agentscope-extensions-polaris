<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tencent.ai.polaris</groupId>
        <artifactId>agentscope-extensions-polaris-example</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agentscope-extensions-polaris-example-a2a</artifactId>
    <packaging>pom</packaging>
    <name>AgentScope Extensions Polaris Example A2A</name>
    <description>A2A agent examples for AgentScope Extensions Polaris</description>

    <modules>
        <module>a2a-mock-model</module>
        <module>a2a-server</module>
        <module>a2a-client</module>
        <module>a2a-server-spring-boot</module>
        <module>a2a-client-spring-boot</module>
    </modules>

    <properties>
        <logback.version>1.5.16</logback.version>
    </properties>

    <!--
      logback binding + slf4j compile scope + fat-jar assembly are declared per leaf module:
      plain-Java apps (a2a-server / a2a-client) need an explicit logback binding and a jar-with-dependencies;
      Spring Boot apps (a2a-*-spring-boot) pull logback from the spring-boot BOM and repackage via
      spring-boot-maven-plugin, so they must NOT inherit a pinned logback-classic version here (it would
      clash with the BOM-managed logback-core, causing NoSuchMethodError at startup).
    -->

</project>
